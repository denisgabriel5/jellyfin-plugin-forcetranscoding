<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ForceTranscode</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ForceTranscode</AssemblyName>
    <Version>0.1.5.0</Version>
    <AssemblyVersion>0.1.5.0</AssemblyVersion>
    <FileVersion>0.1.5.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    References local Jellyfin source for development.
    ExcludeAssets=runtime means these assemblies are not bundled in the plugin;
    the server's own copies are used at runtime.
  -->
  <ItemGroup>
    <ProjectReference Include="../../jellyfin/MediaBrowser.Common/MediaBrowser.Common.csproj">
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../../jellyfin/MediaBrowser.Controller/MediaBrowser.Controller.csproj">
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../../jellyfin/MediaBrowser.Model/MediaBrowser.Model.csproj">
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../../jellyfin/Jellyfin.Api/Jellyfin.Api.csproj">
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
